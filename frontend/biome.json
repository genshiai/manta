{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,json}",
      "!src/components/ui/**",
      "!src/components/patterns/**",
      "!src/utils/styleseed/**",
      "!src/tokens/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "warn",
          "options": {
            "paths": {
              "@/vendor/dads": "レガシー: 新規コードで vendor/dads を使わない（KARTE_UI_SPEC §2-6）",
              "@/lib/cn": "レガシー: cn は @/components/ui/utils を使う（KARTE_UI_SPEC §2-6）"
            }
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
