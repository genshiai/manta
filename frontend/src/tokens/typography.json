{
  "$description": "Manta typography tokens. Apple JP system-font stack, compressed for dense EMR screens.",
  "fontFamily": {
    "sans": "\"SF Pro JP\", \"SF Pro Text\", \"SF Pro Icons\", \"Hiragino Kaku Gothic Pro\", \"ヒラギノ角ゴ Pro W3\", メイリオ, Meiryo, \"ＭＳ Ｐゴシック\", -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', monospace"
  },
  "fontSize": {
    "2xs": "10px",
    "xs": "11px",
    "sm": "12px",
    "caption": "13px",
    "base": "14px",
    "body": "15px",
    "md": "16px",
    "subhead": "17px",
    "lg": "18px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "30px",
    "4xl": "36px",
    "5xl": "48px"
  },
  "fontWeight": {
    "normal": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "lineHeight": {
    "none": 1.0,
    "tight": 1.2,
    "snug": 1.35,
    "normal": 1.5,
    "relaxed": 1.65
  },
  "lineHeightBySize": {
    "$description": "Recommended line-height per font-size tier",
    "display (36-48px)": "none (1.0) or tight (1.2) — large metrics, hero numbers",
    "heading (18-24px)": "snug (1.35) — section titles",
    "body (14-17px)": "normal (1.5) — readable paragraphs",
    "caption (10-13px)": "normal (1.5) or relaxed (1.65) — small text needs more leading"
  },
  "letterSpacing": {
    "body": "-0.012em",
    "heading": "-0.015em",
    "caption": "0em",
    "normal": "0em",
    "wide": "0.05em",
    "wider": "0.1em"
  },
  "letterSpacingBySize": {
    "$description": "Recommended letter-spacing per font-size tier",
    "display (24px+)": "heading (-0.015em) — Apple JP heading tracking",
    "body (15-17px)": "body (-0.012em)",
    "caption (10-14px)": "caption (0em)",
    "caption-uppercase (10-13px)": "wide (0.05em) or wider (0.1em)"
  }
}
