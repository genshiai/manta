# Backend environment variables (Pydantic settings, prefix: MANTA_)
# Copy to backend/.env and fill in actual values. Do not commit .env.

# Environment — development (default) | production
# production では: (1) デフォルトの JWT シークレットでの起動を拒否
#                  (2) デモデータの自動投入を既定で無効化
MANTA_ENV=development

# Demo seed — 明示指定で上書き（未指定なら development=true / production=false）
# MANTA_SEED_DEMO=true

# Database — override only if not using compose default
MANTA_DATABASE_URL=postgresql+psycopg://manta:manta@localhost:5432/manta

# CORS — JSON array (pydantic-settings parses list fields as JSON)
# MANTA_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# JWT — MUST replace with a long random value in any non-local environment
MANTA_JWT_SECRET_KEY=change-me-to-a-long-random-string
MANTA_JWT_ALGORITHM=HS256

# Access token lifetime (minutes)
MANTA_ACCESS_TOKEN_EXPIRE_MINUTES=60
